<p style="color: green"><%= notice %></p>

<% content_for :title, "User Management" %>

<h1>User Management</h1>

<%= link_to "Back to dashboard", root_path %>

<table>
    <tr><th>Email</th><th>Role</th><th>Saved Locations</th><th>Created At</th><th>Actions</th></tr>
    <% @users.each do |user| %>
        <tr>
            <td><%= user.email_address %></td>
            <td><%= user.role %></td>
            <td><%= user.saved_count %></td>
            <td><%= user.created_at %></td>
            <td>
                <%= button_to (user.admin? ? "Demote to User" : "Promote to Admin"), admin_user_path(user), method: :patch %>
                <%= button_to "Delete User", admin_user_path(user), method: :delete, data: { turbo_confirm: "Delete #{user.email_address}?" }, disabled: user == Current.user %>
            </td>
        </tr>
    <% end %>
</table>
