<%= form_with(model: api_usage) do |form| %>
  <% if api_usage.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(api_usage.errors.count, "error") %> prohibited this api_usage from being saved:</h2>

      <ul>
        <% api_usage.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :location_id, style: "display: block" %>
    <%= form.text_field :location_id %>
  </div>

  <div>
    <%= form.label :endpoint, style: "display: block" %>
    <%= form.text_field :endpoint %>
  </div>

  <div>
    <%= form.label :cache_hit, style: "display: block" %>
    <%= form.checkbox :cache_hit %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
