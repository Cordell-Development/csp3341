<div id="<%= dom_id location %>">
  <div>
    <strong>City name:</strong>
    <%= location.city_name %>
  </div>

  <div>
    <strong>Latitude:</strong>
    <%= location.latitude %>
  </div>

  <div>
    <strong>Longitude:</strong>
    <%= location.longitude %>
  </div>

  <div>
    <strong>Is blacklisted:</strong>
    <%= location.is_blacklisted %>
  </div>

</div>
