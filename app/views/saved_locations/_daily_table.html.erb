<table class="w-full text-left">
    <tr><th>Date</th><th>Max</th><th>Min</th><th>Humidity</th><th>Rain (mm)</th></tr>
    <% daily["time"].slice(start, length).each_with_index do |date, i| %>
      <tr>
        <td><%= date %></td>
        <td><%= daily["temperature_2m_max"][i] %>°</td>
        <td><%= daily["temperature_2m_min"][i] %>°</td>
        <td><%= daily["relative_humidity_2m_mean"][i] %>%</td>
        <td><%= daily["rain_sum"][i] %></td>
      </tr>
    <% end %>
</table>