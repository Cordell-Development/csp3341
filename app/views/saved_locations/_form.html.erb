<%= form_with(model: saved_location) do |form| %>
  <% if saved_location.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(saved_location.errors.count, "error") %> prohibited this saved_location from being saved:</h2>

      <ul>
        <% saved_location.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :location_id, style: "display: block" %>
    <%= form.text_field :location_id %>
  </div>

  <div>
    <%= form.label :is_current_location, style: "display: block" %>
    <%= form.checkbox :is_current_location %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
