<h1>Weather Dashboard</h1>
<div>
    <% @saved.each do |sl| %>
        <% loc = sl.location %>
        <% current_day, forecast, history = @weather[loc.id][:current_day], @weather[loc.id][:forecast], @weather[loc.id][:history] %>

        <article>
            <h2><%= loc.city_name %><%= " (Current location)" if sl.current_location? %></h2>
            <p>
                Now: <%= current_day.dig("current", "temperature_2m") %>°C,
                <%= current_day.dig("current", "relative_humidity_2m") %>% humidity
            </p>
            <p>
                Today: <%= forecast.dig("daily", "temperature_2m_max", 0) %>°C /
                    <%= forecast.dig("daily", "temperature_2m_min", 0) %>°C
            </p>
            <details>
                <summary>Hourly (today)</summary>
                <table>
                <tr><th>Time</th><th>Temperature</th><th>Humidity</th><th>Rain (mm)</th></tr>
                <% times = current_day.dig("hourly", "time") %>
                <% temps = current_day.dig("hourly", "temperature_2m") %>
                <% humidity = current_day.dig("hourly", "relative_humidity_2m") %>
                <% rain = current_day.dig("hourly", "rain") %>
                <% times.each_with_index do |t, i| %>
                    <tr>
                    <td><%= Time.parse(t).strftime("%H:%M") %></td>
                    <td><%= temps[i] %>°C</td>
                    <td><%= humidity[i] %>%</td>
                    <td><%= rain[i] %></td>
                    </tr>
                <% end %>
                </table>
            </details>
            <details>
                <summary>Previous 7 days</summary>
                <%= render "daily_table", daily: history["daily"] %> 
            </details>
            <details>
                <summary>Next 7 days</summary>
                <%= render "daily_table", daily: forecast["daily"] %> 
            </details>

            <%= button_to "Remove", saved_location_path(sl), method: :delete, data: { turbo_confirm: "Remove #{loc.city_name}?" } %>
        </article>
    <% end %>
</div>
